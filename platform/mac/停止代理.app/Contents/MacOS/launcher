#!/bin/zsh
# [INPUT]: 服务标签、启停互斥锁与同应用包 status-ui.sh。
# [OUTPUT]: 核验代理退出，在唯一状态窗口显示停止结果。
# [POS]: Mac 停止编排；共用启动提示视图，不按进程名批量停止。
# [PROTOCOL]: 变更时更新此头部，然后检查 CLAUDE.md
APP_CONTENTS="${0:A:h:h}"
LABEL=local.relay-sanitizer
SERVICE="$HOME/Library/Application Support/Relay-Sanitizer"
umask 077
source "$APP_CONTENTS/MacOS/status-ui.sh" || exit 1
mkdir -p "$SERVICE" || { notice '无法创建后台运行目录。' error; exit 1; }
exec >>"$SERVICE/launcher.log" 2>&1
if ! /usr/bin/shlock -f "$SERVICE/start.lock" -p $$; then
 print -r -- '正在安装或启动，请等待当前窗口完成后再停止。'
 : > "$UI_ACTIVATE"
 exit 0
fi
cleanup() { ui_cleanup; rm -f "$SERVICE/start.lock"; }
trap cleanup EXIT
trap 'exit 1' HUP INT TERM
ui_begin '正在停止代理…' || { notice '无法创建停止状态文件。' error; exit 1; }
SERVICE_PID=$(/bin/launchctl list "$LABEL" 2>/dev/null | /usr/bin/awk '/"PID"/ {gsub(";", "", $3); print $3}')
/bin/launchctl remove "$LABEL" 2>/dev/null
MESSAGE='代理已停止。'
[[ -n "$SERVICE_PID" ]] || MESSAGE='代理未在运行。'
for attempt in {1..30}; do
 [[ -z "$SERVICE_PID" ]] || ! kill -0 "$SERVICE_PID" 2>/dev/null && break
 sleep 0.1
done
if [[ -n "$SERVICE_PID" ]] && kill -0 "$SERVICE_PID" 2>/dev/null; then
 notice '代理尚未退出，请稍后重试停止。' error
 exit 1
fi
notice "$MESSAGE" ok
